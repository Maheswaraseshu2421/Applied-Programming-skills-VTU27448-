
class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        int n = nums.length;

        int[] ans = new int[n - k + 1];
        int[] deque = new int[n];

        int front = 0;
        int rear = -1;

        for (int i = 0; i < n; i++) {

            
            while (front <= rear && deque[front] <= i - k) {
                front++;
            }

          
            while (front <= rear && 
                   nums[deque[rear]] <= nums[i]) {
                rear--;
            }

           
            deque[++rear] = i;

            
            if (i >= k - 1) {
                ans[i - k + 1] = nums[deque[front]];
            }
        }

        return ans;
    }
}
